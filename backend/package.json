{
  "name": "renovation-agent-backend",
  "version": "1.0.0",
  "description": "AI-powered renovation planning assistant backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "prep": "npm run lint && npm run build",
    "test:unit": "vitest run --coverage",
    "test:ai-regression": "vitest run --config vitest.ai-regression.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:load": "k6 run load-tests/health-check.k6.js && k6 run load-tests/chat-flow.k6.js",
    "db:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "db:reconcile": "tsx scripts/reconcile-migration-journal.ts",
    "db:seed-products": "tsx scripts/seed-products-catalog.ts",
    "db:check-tables": "tsx scripts/check-db-tables.ts",
    "db:check-migrations": "tsx scripts/check-migrations.ts",
    "db:studio": "tsx node_modules/drizzle-kit/bin.cjs studio",
    "migration:analyze": "tsx scripts/migration-safety/analyze-migration.ts",
    "migration:rollback": "tsx scripts/migration-safety/generate-rollback.ts",
    "migration:validate": "tsx scripts/migration-safety/validate-rollback.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "nodejs",
    "langchain",
    "socket.io",
    "drizzle",
    "ai-agent"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bull-board/api": "^7.0.0",
    "@bull-board/express": "^7.0.0",
    "@google/genai": "^1.50.1",
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.1.40",
    "@langchain/google-genai": "^2.1.27",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@renovation/shared-types": "workspace:*",
    "@sentry/node": "^10.49.0",
    "@sentry/profiling-node": "^10.49.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.104.0",
    "bullmq": "^5.75.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "langchain": "^1.3.3",
    "pg": "^8.20.0",
    "puppeteer-core": "^24.42.0",
    "rate-limiter-flexible": "^11.0.1",
    "resend": "^6.12.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sparticuz/chromium": "^147.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.0",
    "testcontainers": "^11.14.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.4"
  }
}